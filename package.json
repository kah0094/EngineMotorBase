{
  "name": "motor-editor",
  "version": "0.2.0",
  "description": "Editor desktop nativo para a engine Motor",
  "main": "desktop/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test:engine": "npm --prefix motor test",
    "dist:win": "electron-builder --win dir --x64",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kyanthx.motor.editor",
    "productName": "Motor Studio",
    "artifactName": "Motor-Editor-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "motor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "dir", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Motor Editor"
    }
  }
}
